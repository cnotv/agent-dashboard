# Placeholders for CI, not real settings. The container they start never talks to GitHub and
# is thrown away with the runner; the real values live in the repository settings and reach
# the server only through the Deploy workflow. example.com is reserved for examples.
AGENT_DASHBOARD_DOMAIN=dash.example.com
AGENT_DASHBOARD_ALLOWED_USERS=ci-placeholder-user
AGENT_DASHBOARD_GITHUB_APP_CLIENT_ID=ci-placeholder-client-id
AGENT_DASHBOARD_GITHUB_APP_CLIENT_SECRET=ci-placeholder-not-a-secret
