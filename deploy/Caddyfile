# Caddy obtains and renews the certificate for this domain on its own; ports 80 and 443 on
# the server must reach it.
{$AGENT_DASHBOARD_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy dashboard:4317
}
